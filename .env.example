# Copie para .env e ajuste se quiser trocar as senhas padrão do ambiente local.
MYSQL_PASSWORD=tourlocal
MYSQL_ROOT_PASSWORD=root

# Chave para assinar os tokens de login. Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# SMTP para o e-mail de recuperação de senha. Vazio = o link aparece no log da API.
SMTP_HOST=
SMTP_USUARIO=
SMTP_SENHA=
